<?xml version="1.0"?>
<sdf version="1.8">
  <model name="puck">
    <link name="puck_link">

      <!--
        puck.obj spans z=[-0.005, 0] with its own origin at the TOP face,
        so the center of mass sits 2.5mm below the link origin.
      -->
      <inertial>
        <pose>0 0 -0.0025 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>9.683e-6</ixx>
          <iyy>9.683e-6</iyy>
          <izz>19.260e-6</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!--
        Cylinder, not the mesh - dartsim (ignition-physics5) doesn't honor
        <bounce><restitution_coefficient> when the puck's own collision
        shape is a mesh, against either a mesh or a primitive wall (both
        tested, neither rebounds). Matches the mesh's own radius/thickness
        (0.038981m / 0.005m), so it's a very close stand-in for the real
        shape. See air_hockey_table's model.sdf for the matching cushion
        fix and the full test notes.
      -->
      <collision name="puck_collision">
        <geometry>
          <cylinder><radius>0.039</radius><length>0.005</length></cylinder>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.01</mu><mu2>0.01</mu2></ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.8</restitution_coefficient>
            <threshold>0.01</threshold>
          </bounce>
        </surface>
      </collision>

      <visual name="puck_visual">
        <geometry>
          <mesh><uri>meshes/puck.obj</uri></mesh>
        </geometry>
        <material>
          <ambient>0.85 0.1 0.1 1</ambient>
          <diffuse>0.85 0.1 0.1 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

    </link>
  </model>
</sdf>
