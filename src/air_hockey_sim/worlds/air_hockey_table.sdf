<?xml version="1.0"?>
<sdf version="1.8">
  <world name="air_hockey_world">

    <physics name="1ms" type="dartsim">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!--
      Declared explicitly rather than relying on gz-sim's implicit default
      system list: on this machine that default list turned out to be just
      Physics/SceneBroadcaster/UserCommands (no Sensors), which is fragile -
      once a <plugin> is added, gz-sim stops auto-loading defaults
      entirely, so every system in actual use has to be listed here.
      ApplyLinkWrench backs scripts/launch_puck.sh, letting you shove the
      puck across the table to test the cushion bounce.
    -->
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="ignition-gazebo-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"></plugin>
    <!-- Renders table_camera's sensor below - required for any camera/image
         sensor to actually produce frames, not just the interactive GUI view. -->
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!--
      Shadows off: they're one of the more expensive parts of rendering
      this scene for no real payoff on a flat table. A renderer that
      can't keep up with a fast-moving puck drops frames, which looks
      like the puck "teleporting" between positions even though the
      underlying physics (checked directly via logged pose data, not
      the rendered view) moves it continuously - cutting render cost
      here buys headroom before that becomes visible.
    -->
    <scene>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>-0.99 -0.5325 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <!-- Safety-net floor well below the table, in case the puck ever escapes the cushion. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>-0.99 -0.5325 -1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://air_hockey_table</uri>
      <name>air_hockey_table</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Table center, resting on the play surface (z=0.01) with a small drop gap. -->
    <include>
      <uri>model://puck</uri>
      <name>puck</name>
      <pose>-0.99 -0.5325 0.017 0 0 0</pose>
    </include>

    <!--
      No standalone paddle placeholder here anymore - the spawned IRB1200
      (see the launch file's spawn_irb1200 arg) carries a real paddle
      collision body on tool0 (ee_paddle, injected by
      scripts/inject_gz_joint_control.py) that egm_robot_sim.py drives via
      IK, so this world no longer needs a separately-teleported stand-in.
      egm_robot_sim.py still falls back to teleporting a "paddle" model by
      this name if IK setup fails (see its gazebo_sync_loop) - that fallback
      just won't have anything to move without spawn_irb1200:=true failing
      first, which is the only case it's for.
    -->

    <!--
      Overhead data camera - the simulated stand-in for the real physical
      camera perception_node processes. Mounted at 1.8m above the table
      center, looking straight down (same pose convention as user_camera
      below, just lower and actually rendering to a topic). At
      horizontal_fov=1.3rad and 1280x720, this sees ~2.74m x 1.54m at that
      height - comfortably covers the ~2.13m x 1.22m the band markers span
      (table is 1.98x1.065m, markers sit ~75mm further out on each side -
      see table_markers.yml), with margin either side.

      scripts/camera_sim_bridge.py (run by the launch file) subscribes to
      this sensor's ROS-bridged image topic, JPEG-encodes each frame, and
      republishes it as a PuckState on /camera/raw_stream - the exact
      message perception_node already expects, so it runs completely
      unmodified against this simulated feed.
    -->
    <model name="table_camera">
      <static>true</static>
      <pose>-0.99 -0.5325 1.8 0 1.5708 1.5708</pose>
      <link name="camera_link">
        <sensor name="table_camera_sensor" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>false</visualize>
          <topic>table_camera/image</topic>
          <camera>
            <horizontal_fov>1.3</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-0.99 -0.5325 3.2 0 1.5708 1.5708</pose>
      </camera>
    </gui>

  </world>
</sdf>
