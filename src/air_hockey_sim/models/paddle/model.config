<?xml version="1.0"?>
<model>
  <name>Robot Paddle Placeholder</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>Cymbergaj</name>
    <email>azmozgame@gmail.com</email>
  </author>

  <description>
    Stand-in for the ABB robot's end effector until the real robot model
    is added to the repo. A plain cylinder sized to PADDLE_RADIUS_MM
    (49mm, see pc_node/include/config.hpp) - driven kinematically by
    scripts/egm_robot_sim.py, which teleports it to reflect the current
    position it reports over EGM. Not attached to any kinematic chain;
    replace this model (and how it's driven) once the real robot arrives.
  </description>
</model>
