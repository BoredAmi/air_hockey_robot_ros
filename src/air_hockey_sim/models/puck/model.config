<?xml version="1.0"?>
<model>
  <name>Air Hockey Puck</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>Cymbergaj</name>
    <email>azmozgame@gmail.com</email>
  </author>

  <description>
    Free-floating puck, mass and inertia from CAD iProperties (mass 0.025kg,
    ixx=iyy=9.683e-6, izz=19.260e-6 kg*m^2). Near-zero friction approximates
    the real air cushion; the table's cushion band gives it its bounce.
  </description>
</model>
