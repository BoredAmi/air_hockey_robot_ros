# Flat 75x75mm quad, centered at origin, facing +Z, full-image UV mapping.
# Used as a textured decal for each AprilTag marker (plane primitives don't
# get PBR albedo_map textures applied correctly in ign-gazebo6).
v -0.0375 -0.0375 0
v  0.0375 -0.0375 0
v  0.0375  0.0375 0
v -0.0375  0.0375 0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 1
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
